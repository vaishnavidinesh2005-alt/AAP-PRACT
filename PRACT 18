class Car:
    def start(self):
        print("Car started")


class Bike:
    def start(self):
        print("Bike started")


class VehicleFactory:
    @staticmethod
    def create_vehicle(vehicle_type):
        if vehicle_type == "car":
            return Car()
        elif vehicle_type == "bike":
            return Bike()
        else:
            return None


vehicle = VehicleFactory.create_vehicle("car")

if vehicle:
    vehicle.start()
